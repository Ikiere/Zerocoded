# Backend Environment Variables
# Copy this file to .env and fill in real values — NEVER commit .env

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Email (Nodemailer / SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Zerocoded <hello@zerocoded.com>
EMAIL_TO=hello@zerocoded.com

# === JWT (for future auth) ===
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# === CORS ===
ALLOWED_ORIGINS=https://zerocoded.com,https://www.zerocoded.com,http://localhost:5173

# === App ===
NODE_ENV=production
PORT=3001
